# E-mail (IMAP) para ler alertas de vagas (ex: Gmail com Senha de App)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seu_email@gmail.com
IMAP_PASSWORD=sua_senha_de_app_16_digitos

# Telegram Bot (notificações + comando /resume)
TELEGRAM_BOT_TOKEN=seu_token_do_botfather
TELEGRAM_CHAT_ID=0

# IA (Groq / OpenAI compatible) para adaptar currículo com /resume
AI_API_KEY=gsk_sua_chave_groq_ou_openai

# (Opcional) E-mail SMTP caso queira receber também um Digest por e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_16_digitos
SMTP_TO=seu_email@gmail.com

# Diretório de persistência (seen.json e cache de vagas)
DATA_DIR=./data
CONFIG_FILE=./config.yaml
